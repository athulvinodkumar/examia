# =====================================================================
# EXAMIA BACKEND CONFIGURATION (.env)
# Fill in credentials below when ready. The app runs in local development mode
# automatically if credentials are empty.
# =====================================================================

# Application
APP_ENV=development
APP_SECRET_KEY=examia_super_secret_production_key_change_in_prod_938174
FRONTEND_URL=https://examia.athulvinodkumar08.workers.dev
BACKEND_PORT=8000
UPLOAD_DIR=./uploads

# Database (PostgreSQL URL for Supabase / Production, or blank for auto-fallback to local SQLite)
DATABASE_URL=

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=exam-papers

# Google OAuth Credentials (configured in Supabase Auth -> Providers -> Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://examia.athulvinodkumar08.workers.dev/login.html

# Google Gemini AI API Key (from Google AI Studio / Cloud Console)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@examia.io
